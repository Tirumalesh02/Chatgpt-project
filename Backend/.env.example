# Copy this file to .env and fill in real secrets
JWT_SECRET=replace_me_with_long_random_string
MONGODB_URI=mongodb://localhost:27017/chat-gpt-proj
GEMINI_API_KEY=your_gemini_key_here
# Optional aliases supported by the backend (use one key variable only)
# GOOGLE_API_KEY=your_gemini_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key_here
# Optional: comma-separated model failover order
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-pro-latest
# Optional: keep false to reduce quota usage during demos
# ENABLE_VECTOR_MEMORY=false
PINECONE_API_KEY=your_pinecone_key_here
